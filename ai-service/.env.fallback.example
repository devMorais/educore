# ─────────────────────────────────────────────────────────────────────────────
# Provedores de IA de FALLBACK (opcionais) — cadeia de resiliência na geração
# ─────────────────────────────────────────────────────────────────────────────
# Copie as linhas abaixo para o seu arquivo .env e preencha as API keys que quiser.
# Cada provedor só é ativado se a sua key estiver presente. Se nenhuma estiver,
# o serviço usa apenas o Gemini (comportamento atual).
#
# Ordem de tentativa na geração de conteúdo:
#   Gemini (primário)  →  Groq  →  Cerebras  →  OpenRouter  →  Mistral
#
# Todos abaixo são compatíveis com a API da OpenAI e possuem free tier.
# IMPORTANTE: após editar o .env, reinicie o uvicorn (o --reload observa .py, não .env).
#
# Onde criar as chaves (grátis):
#   Groq        → https://console.groq.com/keys
#   Cerebras    → https://cloud.cerebras.ai (API Keys)
#   OpenRouter  → https://openrouter.ai/keys
#   Mistral     → https://console.mistral.ai (La Plateforme → API Keys)

# --- Groq (Llama 3.3 70B) — rápido e confiável, não treina com seus dados ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Cerebras (GPT-OSS 120B) — o mais rápido, maior cota diária ---
# Modelos disponíveis variam por conta; confira em GET /v1/models. Ex.: gpt-oss-120b, zai-glm-4.7
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- OpenRouter (modelos :free) — agrega vários modelos numa só chave ---
# Modelos :free variam em disponibilidade/congestionamento; veja GET /api/v1/models.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Mistral (Mistral Small) — cota generosa de tokens ---
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ─────────────────────────────────────────────────────────────────────────────
# BS-019 — Renovação automática da URI do Gemini Files API (todos OPCIONAIS)
# ─────────────────────────────────────────────────────────────────────────────
# O PDF enviado ao Gemini expira em ~48h. A renovação LAZY (na hora da geração)
# já vem ligada por padrão e não precisa de nada aqui. As linhas abaixo só
# ajustam o comportamento — os defaults são sensatos.
#
# GEMINI_FILE_TTL_HOURS=48               # fallback se a API não informar a expiração
# GEMINI_URI_RENEW_BUFFER_HOURS=1        # na geração: renova se faltar < 1h
# GEMINI_URI_PROACTIVE_HOURS=2           # varredura: renova se faltar < 2h
# GEMINI_URI_SWEEP_ENABLED=true          # liga/desliga a varredura periódica
# GEMINI_URI_SWEEP_INTERVAL_HOURS=12     # de quanto em quanto tempo varre
# GEMINI_URI_SWEEP_MAX_DOCS=200          # teto de docs por varredura (protege a cota)

# --- Storage durável do PDF (UPGRADE recomendado p/ hosts efêmeros, ex. Railway) ---
# Sem isso, o reupload só funciona enquanto o PDF estiver em uploads/ (disco
# efêmero some no redeploy → docs antigos caem no RAG). Para renovação 100%
# confiável, ative UM provedor abaixo. Default = "local" (disco).
#
# PDF_STORAGE_PROVIDER=local             # local | supabase | s3
#
# Opção GRÁTIS recomendada — Supabase Storage (vocês já usam Supabase):
#   crie um bucket privado e gere uma service key em Project Settings → API.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_PDF_BUCKET=educore-pdfs
#
# Opção compatível com S3 — AWS S3 (pago) ou Cloudflare R2 / Backblaze B2 (free tier):
# S3_ENDPOINT_URL=                       # vazio = AWS S3; R2/B2 usam endpoint próprio
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
