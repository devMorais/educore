Options -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP (required for Laravel Sanctum Bearer tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing static files directly (JS, CSS, images, fonts, favicon, router.php)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # All other requests (API calls + Angular SPA routes) pass through router.php
    RewriteRule ^ router.php [L,QSA]
</IfModule>
