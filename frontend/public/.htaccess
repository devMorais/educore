Options -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files and directories directly
    # /api/* is a real directory so requests go directly to api/.htaccess
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Angular SPA routing — all other paths serve index.html
    RewriteRule ^ index.html [L]
</IfModule>
